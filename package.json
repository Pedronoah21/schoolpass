{
  "name": "schoolpass",
  "version": "0.1.0",
  "description": "Controle de acesso escolar para catracas Henry Lumen (online e offline)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc && cp src/db/schema.sql dist/db/",
    "simulador": "tsx src/sim/simulador-lumen.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pedronoah21/schoolpass.git"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/Pedronoah21/schoolpass/issues"
  },
  "homepage": "https://github.com/Pedronoah21/schoolpass#readme",
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "private": true
}
