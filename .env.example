# Copie para .env e ajuste

# Painel e API
PORT=8080
ADMIN_TOKEN=coloque-um-token-longo-e-secreto
DB_FILE=data/schoolpass.db
TZ_ESCOLA=America/Manaus
NOME_ESCOLA=Minha Escola

# Catracas Henry
HENRY_TEMPO_LIBERACAO=5          # segundos que a catraca espera o giro
HENRY_RECONEXAO_MS=5000          # intervalo para reconectar quando cai
HENRY_SINCRONIZACAO_MIN=60       # de quanto em quanto tempo acerta o relógio das catracas
HENRY_CONFIRMA_GIRO=1            # 0 = considera a liberação como passagem (firmware sem aviso de giro)
# HENRY_CODIGOS={"liberarSaida":"5","giroConcluido":"81"}   # ajuste fino dos códigos (ver src/henry/codigos.ts)

# Aviso aos pais: console | webhook | whatsapp
NOTIFICACAO_CANAL=console
# NOTIFICACAO_WEBHOOK_URL=https://seu-n8n/webhook/catraca
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=aviso_catraca

# Reconhecimento facial (quando instalar o terminal)
# FACIAL_CHAVE=uma-chave-secreta-para-o-terminal
